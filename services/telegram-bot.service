[Unit]
Description=Vishva Telegram Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=vishvadir
ExecStart=vishvadir/run_bot.sh
Restart=on-failure
RestartSec=60
StandardOutput=append:vishvadir/tmp/bot.log
StandardError=append:vishvadir/tmp/bot_error.log

[Install]
WantedBy=default.target
